{
  "info": {
    "_postman_id": "7e3d8b2a-8b4d-4f8c-a37a-3e9d7e9c2a10",
    "name": "Incubyte Salary Management API",
    "description": "Postman collection for the Incubyte Salary Management API. Import the companion Local environment and select it before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Employees",
      "item": [
        {
          "name": "Search and paginate employees",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees?search={{search}}&country={{country}}&department={{department}}&page={{page}}&size={{size}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "{{search}}",
                  "disabled": true
                },
                {
                  "key": "country",
                  "value": "{{country}}",
                  "disabled": true
                },
                {
                  "key": "department",
                  "value": "{{department}}",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "size",
                  "value": "{{size}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get employee counts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/employee-counts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "employee-counts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get employee by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employeeId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update employee salary",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/{{employeeId}}/salary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employeeId}}",
                "salary"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"salary\": {{salary}},\n  \"currency\": \"{{currency}}\",\n  \"effectiveDate\": \"{{effectiveDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Salary Insights",
      "item": [
        {
          "name": "Country salary summaries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/insights/country-salaries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "insights",
                "country-salaries"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Job-title salary summaries by country",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/insights/job-title-salaries?country={{country}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "insights",
                "job-title-salaries"
              ],
              "query": [
                {
                  "key": "country",
                  "value": "{{country}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "employeeId",
      "value": "1"
    },
    {
      "key": "search",
      "value": ""
    },
    {
      "key": "country",
      "value": "India"
    },
    {
      "key": "department",
      "value": "Engineering"
    },
    {
      "key": "page",
      "value": "0"
    },
    {
      "key": "size",
      "value": "10"
    },
    {
      "key": "salary",
      "value": "95000.00"
    },
    {
      "key": "currency",
      "value": "INR"
    },
    {
      "key": "effectiveDate",
      "value": "2026-10-01"
    }
  ]
}